{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keycard Shell Updater",
  "version": "2.1.0",
  "identifier": "com.github.choppu.kshell-updater",
  "build": {
    "frontendDist": "../frontend",
    "beforeDevCommand": "npm run ui:watch",
    "beforeBuildCommand": "npm run ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keycard Shell Updater",
        "width": 936,
        "height": 712,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "center": true,
        "backgroundColor": "#010101"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "../build/macos/Info.plist"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-keycard-shell.rules": "../build/linux/99-keycard-shell.rules"
        },
        "postInstallScript": "../build/linux/deb-post-install",
        "postRemoveScript": "../build/linux/deb-post-removal"
      }
    }
  }
}
