{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keycard Shell Updater",
  "version": "2.0.0",
  "identifier": "com.github.choppu.kshell-updater",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keycard Shell Updater",
        "width": 936,
        "height": 774,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "center": true,
        "backgroundColor": "#010101"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
