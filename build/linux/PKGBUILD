# Keycard Shell Updater, packaged for Arch from source.
#
#   makepkg -si
#
# The camera is opened by the app itself, over V4L2, so nothing here needs a media framework: the
# webkit2gtk dependency is the window, not the picture. Installing natively is also how the app gets
# the system's own SSL and proxy arrangement rather than an AppImage's private copy of things.
#
# To package a tree of your own instead of the published one:
#
#   KSHELL_REPO=file:///home/milles/git/kshell-updater makepkg -si
#
# A git source packages what is committed, so commit the changes you want first.
pkgname=kshell-updater
pkgrel=1
pkgdesc='Update the firmware and database of a Keycard Shell, and verify its authenticity'
arch=('x86_64')
url='https://github.com/choppu/kshell-updater'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'hidapi')
makedepends=('cargo' 'nodejs' 'npm')
_repo=${KSHELL_REPO:-https://github.com/choppu/kshell-updater.git}
source=("kshell-updater::git+${_repo}")
sha256sums=('SKIP')
options=(!debug)

# The version lives in package.json, where the app and the release read it. No node here: makepkg
# runs pkgver() before it installs makedepends.
pkgver() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$srcdir/$pkgname/package.json" | head -1
}

build() {
  cd "$srcdir/$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  export npm_config_cache="$srcdir/npm-cache"
  npm ci
  npm run ui
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 src-tauri/target/release/kshell-updater "$pkgdir/usr/bin/kshell-updater"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/kshell-updater.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/kshell-updater.png"
  install -Dm644 'src-tauri/icons/128x128@2x.png' \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/kshell-updater.png"
  # Opening the Shell needs write access to its /dev/hidraw node.
  install -Dm644 build/linux/99-keycard-shell.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-keycard-shell.rules"
}
